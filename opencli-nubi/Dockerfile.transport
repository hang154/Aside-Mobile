FROM python:3.12-slim
WORKDIR /app
COPY requirements-transport.txt ./
RUN pip install --no-cache-dir -r requirements-transport.txt && useradd --create-home --uid 10001 nubi
COPY nubi_transport_api.py nubi_transit.py rail_journey.py express_bus.py tago_catalog.py kakao_location.py public_info.py ./
USER nubi
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "nubi_transport_api:app", "--host", "0.0.0.0", "--port", "8080"]
