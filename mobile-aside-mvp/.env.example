# Core Android runtime does not require a PC, ADB, API token or local MCP process.
# Optional development-only OpenCLI regression environment:
OPENCLI_BIN=/absolute/path/to/OpenCLI/dist/src/main.js
OPENCLI_CDP_ENDPOINT=http://127.0.0.1:19336
# Official API credentials are NOT embedded in Android or supplied in this file.
